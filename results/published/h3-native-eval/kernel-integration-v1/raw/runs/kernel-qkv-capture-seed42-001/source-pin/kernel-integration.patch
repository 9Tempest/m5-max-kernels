+/* Explicit diagnostic-only capture. Adds a submit/wait and restart at nine
+ * sampled blocks. These runs must never be used as performance measurements.
+ * Full K rows preserve post-SwiGLU BF16 storage; source precision is recorded. */
+static int capture_fc2_rows(h3_dit *dit, unsigned block, int step,
+                            uint32_t rows, char *error, size_t error_size) {
+    const char *directory = getenv("H3_FC2_CAPTURE_DIR");
+    if (!directory || !*directory) return 1;
+    if ((step != 0 && step != dit->sigmas.steps / 2 && step != dit->sigmas.steps - 1) ||
+        (block != 0 && block != 24 && block != 49)) return 1;
+    if (dit->token_reduction_active || rows != dit->sequence || !dit->int8_mlp) {
+        fail(error, error_size, "FC2 capture requires full packed sequence and INT8 MLP");
+        return 0;
+    }
+    if (!h3_gpu_submit(dit->gpu)) {
+        fail(error, error_size, "FC2 capture submit failed: %s", h3_gpu_error(dit->gpu));
+        return 0;
+    }
+    uint32_t ids[64];
+    size_t count = 0;
+    for (size_t segment = 0; segment < dit->layout.segment_count; ++segment) {
+        size_t first = dit->layout.segments[segment].start;
+        size_t stop = dit->layout.segments[segment].stop;
+        if (stop <= first) continue;
+        size_t selected[] = {first, first + (stop-first)/2, stop-1};
+        for (size_t j=0; j<3; ++j) {
+            int seen=0;
+            for (size_t k=0; k<count; ++k) seen |= ids[k] == selected[j];
+            if (!seen) {
+                if (count >= 64) { fail(error,error_size,"too many FC2 sample rows"); return 0; }
+                ids[count++] = (uint32_t)selected[j];
+            }
+        }
+    }
+    /* Additional uniformly spread rows catch different temporal/video blocks. */
+    for (uint32_t j=1; j<8; ++j) {
+        uint32_t selected=(uint32_t)(((uint64_t)(rows-1)*j)/8u);
+        int seen=0;
+        for (size_t k=0;k<count;++k) seen |= ids[k] == selected;
+        if (!seen && count<64) ids[count++]=selected;
+    }
+    char binary_path[4096], json_path[4096];
+    int a=snprintf(binary_path,sizeof(binary_path),"%s/fc2-step%02d-block%02u.bf16",directory,step,block);
+    int b=snprintf(json_path,sizeof(json_path),"%s/fc2-step%02d-block%02u.json",directory,step,block);
+    if(a<0 || b<0 || (size_t)a>=sizeof(binary_path) || (size_t)b>=sizeof(json_path)) {
+        fail(error,error_size,"FC2 capture path too long"); return 0;
+    }
+    uint16_t *sample=malloc(count * FFN * sizeof(*sample));
+    if(!sample) { fail(error,error_size,"FC2 capture out of memory"); return 0; }
+    int ok=1;
+    size_t nonfinite=0;
+    for(size_t j=0;j<count && ok;++j) {
+        ok=h3_gpu_tensor_read_bf16_range(dit->activated,(size_t)ids[j]*FFN,sample+j*FFN,FFN);
+        for(size_t k=0;k<FFN && ok;++k) nonfinite += (sample[j*FFN+k]&0x7f80u)==0x7f80u;
+    }
+    if(!ok || nonfinite) {
+        free(sample); fail(error,error_size,"FC2 capture read failed or nonfinite values (%zu)",nonfinite); return 0;
+    }
+    int fd=open(binary_path,O_WRONLY|O_CREAT|O_EXCL,0600);
+    FILE *binary=fd<0?NULL:fdopen(fd,"wb");
+    if(!binary) { if(fd>=0) close(fd); free(sample); fail(error,error_size,"FC2 capture exclusive open failed: %s",strerror(errno)); return 0; }
+    ok=fwrite(sample,sizeof(*sample),count*FFN,binary)==count*FFN;
+    ok=fclose(binary)==0 && ok;
+    free(sample);
+    if(!ok) { fail(error,error_size,"FC2 capture write failed"); return 0; }
+    fd=open(json_path,O_WRONLY|O_CREAT|O_EXCL,0600);
+    FILE *json=fd<0?NULL:fdopen(fd,"w");
+    if(!json) { if(fd>=0) close(fd); fail(error,error_size,"FC2 metadata exclusive open failed"); return 0; }
+    fprintf(json,"{\"schema\":1,\"scope\":\"diagnostic_with_extra_gpu_waits\",\"input\":\"post_SwiGLU_BF16_on_native_INT8_FC1_trajectory\",\"step\":%d,\"block\":%u,\"packed_rows\":%u,\"sample_rows\":%zu,\"width\":%d,\"int8_qkv\":%d,\"int8_attention_out\":%d,\"hadamard_fc2\":%d,\"row_ids\":[",step,block,rows,count,FFN,dit->int8_qkv,dit->int8_attention_out,dit->use_hadamard_fc2);
+    for(size_t j=0;j<count;++j) fprintf(json,"%s%u",j?",":"",ids[j]);
+    fprintf(json,"],\"segments\":[");
+    for(size_t j=0;j<dit->layout.segment_count;++j) {
+        const h3_segment *s=&dit->layout.segments[j];
+        fprintf(json,"%s{\"kind\":%d,\"start\":%zu,\"stop\":%zu}",j?",":"",s->kind,s->start,s->stop);
+    }
+    fprintf(json,"],\"nonfinite\":0,\"dtype\":\"BF16 little endian\"}\n");
+    ok=!ferror(json); ok=fclose(json)==0 && ok;
+    if(!ok || !h3_gpu_begin(dit->gpu)) { fail(error,error_size,"FC2 capture metadata/restart failed"); return 0; }
+    fprintf(stderr,"h3 fc2 capture: step=%d block=%u rows=%zu K=%d (diagnostic extra wait)\n",step,block,count,FFN);
+    return 1;
+}
+
+
+/* Opt-in actual prep capture; inputs are snapshotted before any in-place gate.
+ * Normal execution makes exactly the selected prep call, with no new dispatch
+ * or readback. Captures deliberately submit/restart and are never perf runs. */
+static int h256_capture_write(const char *stem, const char *suffix,
+                              const void *data, size_t bytes) {
+    char path[4096];
+    int n=snprintf(path,sizeof(path),"%s-%s",stem,suffix);
+    if(n<0 || (size_t)n>=sizeof(path)) return 0;
+    int fd=open(path,O_WRONLY|O_CREAT|O_EXCL,0600);
+    if(fd<0) return 0;
+    FILE *f=fdopen(fd,"wb");
+    if(!f) { close(fd); return 0; }
+    int ok=fwrite(data,1,bytes,f)==bytes;
+    return fclose(f)==0 && ok;
+}
+
+static int prepare_h256_input(h3_dit *dit, const char *family, unsigned block,
+        int step, uint32_t rows, const h3_gpu_tensor *branch,
+        const h3_gpu_tensor *gamma, const h3_gpu_tensor *gate_modulation,
+        const h3_gpu_tensor *norm_modulation, const h3_gpu_tensor *gate_map,
+        const h3_gpu_tensor *norm_map, unsigned gate_slot, unsigned shift_slot,
+        unsigned scale_slot, int apply_gate, h3_gpu_tensor *scratch,
+        char *error, size_t error_size) {
+    const char *directory=getenv("H3_ADALN_CAPTURE_DIR");
+    int capture=directory && (step==0 || step==dit->sigmas.steps/2 ||
+        step==dit->sigmas.steps-1) && (block==0 || block==24 || block==49);
+    uint32_t padded=(rows+127u)&~127u;
+    uint32_t ids[16], gm[16]={0}, nm[16]={0};
+    size_t count=0;
+    uint16_t *samples=NULL;
+    char stem[4096];
+    if(capture) {
+        if(!*directory || rows!=dit->sequence || dit->token_reduction_active) {
+            fail(error,error_size,"H256 capture needs a nonempty directory and full packed rows"); return 0;
+        }
+        /* Include each actual modality boundary, then spread remaining rows. */
+        for(size_t segment=0;segment<dit->layout.segment_count;++segment) {
+            const h3_segment *part=&dit->layout.segments[segment];
+            if(part->stop<=part->start) continue;
+            size_t selected[]={part->start,part->start+(part->stop-part->start)/2,part->stop-1};
+            for(size_t j=0;j<3;++j) {
+                int seen=0;
+                for(size_t k=0;k<count;++k) seen|=ids[k]==selected[j];
+                if(!seen) {
+                    if(count==16) { fail(error,error_size,"H256 capture exceeds 16 boundary rows"); return 0; }
+                    ids[count++]=(uint32_t)selected[j];
+                }
+            }
+        }
+        for(uint32_t divisor=16;count<16 && divisor<=256;divisor*=2) {
+            for(uint32_t j=1;j<divisor && count<16;++j) {
+                uint32_t id=(uint32_t)(((uint64_t)(rows-1)*j)/divisor);
+                int seen=0;
+                for(size_t k=0;k<count;++k) seen|=ids[k]==id;
+                if(!seen) ids[count++]=id;
+            }
+        }
+        if(count!=16) { fail(error,error_size,"H256 capture requires 16 distinct rows"); return 0; }
+        int n=snprintf(stem,sizeof(stem),"%s/%s-step%02d-block%02u",directory,family,step,block);
+        if(n<0 || (size_t)n>=sizeof(stem)) { fail(error,error_size,"H256 capture path too long"); return 0; }
+        if(!h3_gpu_submit(dit->gpu)) { fail(error,error_size,"H256 capture input submit failed"); return 0; }
+        /* Per-row residual, branch, gate, shift, scale; one gamma vector. */
+        size_t span=count*HIDDEN;
+        samples=calloc(5*span+HIDDEN,sizeof(*samples));
+        int ok=samples!=NULL;
+        for(size_t j=0;j<count && ok;++j) {
+            ok=h3_gpu_tensor_read_bf16_range(dit->hidden,(size_t)ids[j]*HIDDEN,
+                    samples+j*HIDDEN,HIDDEN) &&
+               h3_gpu_tensor_read_u32_range(norm_map,ids[j],nm+j,1);
+            if(apply_gate) ok=ok &&
+                h3_gpu_tensor_read_bf16_range(branch,(size_t)ids[j]*HIDDEN,samples+span+j*HIDDEN,HIDDEN) &&
+                h3_gpu_tensor_read_u32_range(gate_map,ids[j],gm+j,1) &&
+                h3_gpu_tensor_read_bf16_range(gate_modulation,
+                    ((size_t)gm[j]*SLOTS+gate_slot)*HIDDEN,samples+2*span+j*HIDDEN,HIDDEN);
+            ok=ok && h3_gpu_tensor_read_bf16_range(norm_modulation,
+                    ((size_t)nm[j]*SLOTS+shift_slot)*HIDDEN,samples+3*span+j*HIDDEN,HIDDEN) &&
+                h3_gpu_tensor_read_bf16_range(norm_modulation,
+                    ((size_t)nm[j]*SLOTS+scale_slot)*HIDDEN,samples+4*span+j*HIDDEN,HIDDEN);
+        }
+        ok=ok && h3_gpu_tensor_read_bf16(gamma,samples+5*span,HIDDEN);
+        size_t nonfinite=0;
+        if(samples) for(size_t j=0;j<5*span+HIDDEN;++j) nonfinite+=(samples[j]&0x7f80u)==0x7f80u;
+        if(!ok || nonfinite) { free(samples); fail(error,error_size,"H256 capture inputs unreadable/nonfinite"); return 0; }
+        const char *names[]={"residual.bf16","branch.bf16","gate.bf16","shift.bf16","scale.bf16"};
+        for(size_t j=0;j<5 && ok;++j) ok=h256_capture_write(stem,names[j],samples+j*span,span*sizeof(*samples));
+        ok=ok && h256_capture_write(stem,"gamma.bf16",samples+5*span,HIDDEN*sizeof(*samples)) &&
+            h256_capture_write(stem,"gate-map.u32",gm,count*sizeof(*gm)) &&
+            h256_capture_write(stem,"norm-map.u32",nm,count*sizeof(*nm));
+        free(samples); samples=NULL;
+        if(!ok || !h3_gpu_begin(dit->gpu)) { fail(error,error_size,"H256 input capture write/restart failed"); return 0; }
