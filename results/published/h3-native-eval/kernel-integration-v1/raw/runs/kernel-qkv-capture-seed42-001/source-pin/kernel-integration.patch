+    BOOL grouped = policy == 0;
+    BOOL hadamard = policy == 1;
+    BOOL n256 = !grouped && hidden_dim == 14336u && rows <= 2048u && output_dim % 256u == 0;
+    BOOL local = grouped && getenv("H3_INT8_GROUP_FC2_THREADGROUP") == NULL;
+    BOOL local128 = grouped && getenv("H3_INT8_GROUP_FC2_LOCAL128") != NULL;
+    if (!h3_gpu_require_i8(gpu, weight, (size_t)output_dim * hidden_dim, @"FC2 INT8 weight") ||
+        !h3_gpu_require_f32(gpu, weight_scales, output_dim, @"FC2 weight scales") ||
+        !h3_gpu_require_bf16(gpu, output, (size_t)rows * output_dim, @"FC2 BF16 output") ||
+        !h3_gpu_require_command(gpu)) return 0;
