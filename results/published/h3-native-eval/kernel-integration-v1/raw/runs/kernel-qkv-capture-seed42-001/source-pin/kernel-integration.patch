+kernel void h3_m5_qkv_rope_int8_r64_swizzle8(
+    device int8_t *input [[buffer(0)]],
+    device int8_t *weight [[buffer(1)]],
+    device const float *input_scales [[buffer(2)]],
+    device const float *weight_scales [[buffer(3)]],
