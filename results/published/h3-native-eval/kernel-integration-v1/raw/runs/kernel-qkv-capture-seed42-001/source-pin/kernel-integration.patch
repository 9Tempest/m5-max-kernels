+static int h3_gpu_fc2_int8_bf16_impl(h3_gpu *opaque, h3_gpu_tensor *output,
+                         h3_gpu_tensor *quantized_activation,
+                         h3_gpu_tensor *activation_scales,
+                         const h3_gpu_tensor *activated,
+                         const h3_gpu_tensor *weight,
+                         const h3_gpu_tensor *weight_scales,
+                         uint32_t rows, uint32_t hidden_dim,
+                         uint32_t output_dim, int policy,
+                         int use_slower_grouped_quantizer,
+                         const h3_gpu_tensor *gate_residual,
+                         const h3_gpu_tensor *gate_modulation,
+                         const h3_gpu_tensor *gate_row_map,
