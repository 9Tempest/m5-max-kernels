+struct h3_adaln_h256_args {
+    uint rows, width, slots, gate_slot, shift_slot, scale_slot;
+    float epsilon;
+    uint apply_gate, write_adaln;
+};
+
+kernel void h3_adaln_h256_int8_k5376(
+        device const ushort *residual [[buffer(0)]],
+        device const ushort *branch [[buffer(1)]],
+        device const ushort *gamma [[buffer(2)]],
+        device const ushort *gate_modulation [[buffer(3)]],
+        device const ushort *norm_modulation [[buffer(4)]],
+        device const uint *gate_map [[buffer(5)]],
+        device const uint *norm_map [[buffer(6)]],
+        device ushort *gated_residual [[buffer(7)]],
+        device int8_t *codes [[buffer(8)]],
+        device float *scales [[buffer(9)]],
+        device ushort *adaln_capture [[buffer(10)]],
+        constant h3_adaln_h256_args &args [[buffer(11)]],
+        uint tid [[thread_index_in_threadgroup]],
+        ushort sg [[simdgroup_index_in_threadgroup]],
+        ushort lane [[thread_index_in_simdgroup]],
+        uint row [[threadgroup_position_in_grid]]) {
+    constexpr uint width=5376, groups=8, slots=3, registers=8;
+    uint base=row*width;
+    if(row>=args.rows) {
+        for(uint j=tid;j<width;j+=256) codes[base+j]=0;
+        if(tid==0) scales[row]=1.0f;
+        return;
+    }
+    threadgroup ushort rounded[width];
+    threadgroup float reductions[256];
+    uint norm_base=norm_map[row]*args.slots*width;
+    uint gate_base=args.apply_gate ? gate_map[row]*args.slots*width : 0;
+    float sum=0.0f;
+    for(uint j=tid;j<width;j+=256) {
+        ushort bits=residual[base+j];
+        if(args.apply_gate) {
+            float gate=h3_bf16_to_f32(gate_modulation[gate_base+args.gate_slot*width+j]);
+            bits=h3_f32_to_bf16(h3_bf16_to_f32(bits)+
+                h3_bf16_to_f32(branch[base+j])*gate);
+            gated_residual[base+j]=bits;
+        }
+        rounded[j]=bits;
+        float x=h3_bf16_to_f32(bits);
+        sum=fma(x,x,sum);
+    }
+    reductions[tid]=sum;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for(uint stride=128;stride;stride>>=1) {
+        if(tid<stride) reductions[tid]+=reductions[tid+stride];
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    float inv=rsqrt(reductions[0]/float(width)+args.epsilon);
+    for(uint j=tid;j<width;j+=256) {
+        float normalized=h3_bf16_to_f32(rounded[j])*inv*h3_bf16_to_f32(gamma[j]);
+        float shift=h3_bf16_to_f32(norm_modulation[norm_base+args.shift_slot*width+j]);
+        float scale=h3_bf16_to_f32(norm_modulation[norm_base+args.scale_slot*width+j]);
+        ushort bits=h3_f32_to_bf16(normalized*(1.0f+scale)+shift);
+        rounded[j]=bits;
+        if(args.write_adaln) adaln_capture[base+j]=bits;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float values[slots][registers];
+    float peak=0.0f;
+    #pragma unroll
+    for(uint slot=0;slot<slots;++slot) {
+        uint block=slot*groups+sg;
+        #pragma unroll
+        for(uint reg=0;reg<registers;++reg) {
+            float v=block<21 ? h3_bf16_to_f32(rounded[block*256+reg*32+lane]) : 0.0f;
+            #pragma unroll
+            for(uint stride=1;stride<32;stride*=2) {
+                float peer=simd_shuffle_xor(v,stride);
+                v=(lane&stride) ? peer-v : v+peer;
+            }
+            values[slot][reg]=v;
+        }
+        #pragma unroll
+        for(uint stride=1;stride<registers;stride*=2) {
+            #pragma unroll
+            for(uint start=0;start<registers;start+=2*stride) {
+                #pragma unroll
+                for(uint j=0;j<stride;++j) {
+                    float a=values[slot][start+j], b=values[slot][start+j+stride];
+                    values[slot][start+j]=a+b;
+                    values[slot][start+j+stride]=a-b;
+                }
+            }
+        }
+        #pragma unroll
+        for(uint reg=0;reg<registers;++reg) {
+            values[slot][reg]*=0.0625f;
+            peak=max(peak,abs(values[slot][reg]));
+        }
+    }
+    peak=simd_max(peak);
+    if(lane==0) reductions[sg]=peak;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    peak=simd_max(lane<groups ? reductions[lane] : 0.0f);
+    float scale=peak==0.0f ? 1.0f : peak/127.0f;
+    if(tid==0) scales[row]=scale;
+    #pragma unroll
+    for(uint slot=0;slot<slots;++slot) {
+        uint block=slot*groups+sg;
+        if(block<21) {
+            #pragma unroll
+            for(uint reg=0;reg<registers;++reg)
+                codes[base+block*256+reg*32+lane]=int8_t(clamp(
+                    rint(values[slot][reg]/scale),-127.0f,127.0f));
+        }
+    }
+}
