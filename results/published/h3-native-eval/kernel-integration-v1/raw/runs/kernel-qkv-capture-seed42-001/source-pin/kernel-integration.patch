+        local ? @"h3_linear_int8_grouped_local_nax_r128x64" :
+        grouped ? @"h3_linear_int8_grouped_nax_r128x64" :
+        n256 ? @"h3_linear_int8_nax_r128x256_full_k14336" :
+        hidden_dim == 14336u && output_dim == 5376u ?
+            @"h3_linear_int8_nax_r128_full_k14336" : @"h3_linear_int8_nax_r128";
+    if (fused_gate) name = [name stringByAppendingString:@"_gate"];
+    NSUInteger threads = n256 ? 512u : local || local128 ? 256u : grouped ? 128u : 256u;
+    id<MTLComputePipelineState> pipeline = h3_gpu_pipeline(gpu, name);
+    if (!pipeline || pipeline.maxTotalThreadsPerThreadgroup < threads) {
+        h3_gpu_set_error(gpu, @"FC2 INT8 pipeline unavailable; no fallback");
+        return 0;
+    }
