+/* Native RMS/AdaLN BF16 boundary -> normalized H256 -> row INT8.
+ * Independent U32 maps index [condition,slots,width] BF16 tables; callers
+ * guarantee map bounds and finite inputs before encoding. In-place residual
+ * updates are supported; other outputs must not alias inputs/each other.
+ * staged=1 uses existing gate/AdaLN plus independent H packing, requiring
+ * BF16 scratch[rows,width]. Fused (staged=0) accepts NULL scratch, or writes
+ * the post-AdaLN BF16 values to supplied scratch for diagnostic readback.
+ * apply_gate=0 requires gated_residual==residual and leaves it unchanged.
+ * No synchronization/readback is performed by this API. */
+int h3_gpu_adaln_h256_int8(h3_gpu *opaque,
+                     h3_gpu_tensor *gated_residual,
+                     h3_gpu_tensor *quantized_output, h3_gpu_tensor *quantized_scales,
+                     h3_gpu_tensor *bf16_scratch,
+                     const h3_gpu_tensor *residual, const h3_gpu_tensor *branch,
+                     const h3_gpu_tensor *norm_weight,
+                     const h3_gpu_tensor *gate_modulation,
+                     const h3_gpu_tensor *norm_modulation,
+                     const h3_gpu_tensor *gate_row_map,
+                     const h3_gpu_tensor *norm_row_map,
+                     uint32_t rows, uint32_t padded_rows, uint32_t width,
+                     uint32_t slots, uint32_t gate_slot,
+                     uint32_t shift_slot, uint32_t scale_slot,
+                     float epsilon, int apply_gate, int staged)
+ {
+    H3GPU *gpu=GPU(opaque);
+    size_t elements=(size_t)rows*width, padded=(size_t)padded_rows*width;
+    if(!gpu.tensorOpsEnabled || width!=5376u || !rows || padded_rows<rows ||
+       padded>UINT32_MAX || !slots || gate_slot>=slots || shift_slot>=slots ||
+       scale_slot>=slots || !isfinite(epsilon) || epsilon<=0.0f ||
+       (apply_gate!=0 && apply_gate!=1) || (staged!=0 && staged!=1) ||
+       (staged && !bf16_scratch) || (!apply_gate && gated_residual!=residual) ||
+       (bf16_scratch && (bf16_scratch==residual || bf16_scratch==gated_residual ||
+                        bf16_scratch==branch))) {
+        h3_gpu_set_error(gpu,@"AdaLN H256 requires K5376, valid dimensions/slots, explicit 0/1 modes and staged scratch; no fallback");
+        return 0;
+    }
+    if(!h3_gpu_require_bf16(gpu,residual,elements,@"H256 residual") ||
+       !h3_gpu_require_bf16(gpu,gated_residual,elements,@"H256 residual output") ||
+       !h3_gpu_require_bf16(gpu,norm_weight,width,@"H256 gamma") ||
+       !h3_gpu_require_bf16(gpu,norm_modulation,(size_t)slots*width,@"H256 modulation") ||
+       !h3_gpu_require_elements(gpu,norm_row_map,rows,@"H256 norm row map") ||
+       TENSOR(norm_row_map).dtype!=H3_GPU_U32 ||
+       !h3_gpu_require_i8(gpu,quantized_output,padded,@"H256 codes") ||
+       !h3_gpu_require_f32(gpu,quantized_scales,padded_rows,@"H256 scales") ||
+       (bf16_scratch && !h3_gpu_require_bf16(gpu,bf16_scratch,elements,@"H256 AdaLN capture")) ||
+       !h3_gpu_require_command(gpu)) return 0;
+    if(apply_gate &&
+       (!h3_gpu_require_bf16(gpu,branch,elements,@"H256 branch") ||
+        !h3_gpu_require_bf16(gpu,gate_modulation,(size_t)slots*width,@"H256 gate modulation") ||
+        !h3_gpu_require_elements(gpu,gate_row_map,rows,@"H256 gate row map") ||
+        TENSOR(gate_row_map).dtype!=H3_GPU_U32)) return 0;
+    if(staged) {
+        if(apply_gate && !h3_gpu_gate_bf16(opaque,gated_residual,residual,
+            branch,gate_modulation,gate_row_map,rows,width,slots,gate_slot)) return 0;
+        return h3_gpu_adaln_bf16(opaque,bf16_scratch,
+            apply_gate ? gated_residual : residual,norm_weight,norm_modulation,
+            norm_row_map,rows,width,slots,shift_slot,scale_slot,epsilon) &&
+            h3_gpu_quantize_h256_int8(opaque,quantized_output,quantized_scales,
+                bf16_scratch,rows,padded_rows,width);
+    }
+    id<MTLComputePipelineState> pipeline=h3_gpu_pipeline(gpu,@"h3_adaln_h256_int8_k5376");
+    if(!pipeline || pipeline.maxTotalThreadsPerThreadgroup<256) {
+        h3_gpu_set_error(gpu,@"AdaLN H256 pipeline unavailable; no fallback"); return 0;
+    }
+    typedef struct {
+        uint32_t rows,width,slots,gate_slot,shift_slot,scale_slot;
+        float epsilon;
+        uint32_t apply_gate,write_adaln;
+    } h256_args;
+    h256_args args={rows,width,slots,gate_slot,shift_slot,scale_slot,epsilon,
+                   (uint32_t)apply_gate,bf16_scratch ? 1u : 0u};
+    @autoreleasepool {
+        id<MTLComputeCommandEncoder> encoder=[gpu.command computeCommandEncoder];
+        [encoder setComputePipelineState:pipeline];
+        const h3_gpu_tensor *buffers[]={residual,apply_gate ? branch : residual,
+            norm_weight,apply_gate ? gate_modulation : norm_modulation,
+            norm_modulation,apply_gate ? gate_row_map : norm_row_map,norm_row_map,
+            gated_residual,quantized_output,quantized_scales,
+            bf16_scratch ? bf16_scratch : gated_residual};
+        for(NSUInteger i=0;i<11;++i) [encoder setBuffer:TENSOR(buffers[i]).buffer offset:0 atIndex:i];
+        [encoder setBytes:&args length:sizeof(args) atIndex:11];
+        [encoder dispatchThreadgroups:MTLSizeMake(padded_rows,1,1)
+                 threadsPerThreadgroup:MTLSizeMake(256,1,1)];
+        [encoder endEncoding];
+    }
+    h3_gpu_stats stats=gpu.stats; stats.direct_dispatches++; gpu.stats=stats;
+    return 1;
+}
