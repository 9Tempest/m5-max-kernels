 /* Draw Things/ccv-style dynamic symmetric row quantization. Weight rows are
  * checkpoint output channels; activation rows include zero-padded M tails so
  * the int8 matmuls can keep a fully static 128x128x128 descriptor. */
+/* Plain normalized H256. Each SIMD group owns seven complete 256-wide
+ * blocks, with the upper three butterfly dimensions in per-lane registers.
+ * Preserves BF16 input, computes the transform in FP32, quantizes directly;
+ * no transformed BF16 round, signs, clipping or CPU/GPU buffer roundtrip.
+ * Whole-row scales deliberately differ from native FC2 group1024 scales. */
+kernel void h3_quantize_bf16_h256_int8_rows_k14336(
+        device const bfloat *input [[buffer(0)]],
+        device int8_t *output [[buffer(1)]],
+        device float *scales [[buffer(2)]],
+        constant int8_quant_args &args [[buffer(3)]],
+        uint tid [[thread_index_in_threadgroup]],
+        ushort sg [[simdgroup_index_in_threadgroup]],
+        ushort lane [[thread_index_in_simdgroup]],
+        uint row [[threadgroup_position_in_grid]]) {
+    constexpr uint width=14336, slots=7, registers=8, groups=8;
+    uint base=row*width;
+    if(row>=args.rows) {
+        for(uint j=tid;j<width;j+=256) output[base+j]=0;
+        if(tid==0) scales[row]=1.0f;
+        return;
+    }
+    float values[slots][registers];
+    threadgroup float partials[groups];
+    float peak=0.0f;
+    #pragma unroll
+    for(uint slot=0;slot<slots;++slot) {
+        uint block=slot*groups+sg;
+        #pragma unroll
+        for(uint reg=0;reg<registers;++reg) {
+            float v=float(input[base+block*256+reg*32+lane]);
+            #pragma unroll
+            for(uint stride=1;stride<32;stride*=2) {
+                float peer=simd_shuffle_xor(v,stride);
+                v=(lane&stride) ? peer-v : v+peer;
+            }
+            values[slot][reg]=v;
+        }
+        #pragma unroll
+        for(uint stride=1;stride<registers;stride*=2) {
+            #pragma unroll
+            for(uint start=0;start<registers;start+=2*stride) {
+                #pragma unroll
+                for(uint j=0;j<stride;++j) {
+                    float a=values[slot][start+j], b=values[slot][start+j+stride];
+                    values[slot][start+j]=a+b;
+                    values[slot][start+j+stride]=a-b;
+                }
+            }
+        }
+        #pragma unroll
+        for(uint reg=0;reg<registers;++reg) {
+            values[slot][reg]*=0.0625f;
+            peak=max(peak,abs(values[slot][reg]));
+        }
+    }
+    peak=simd_max(peak);
+    if(lane==0) partials[sg]=peak;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    peak=simd_max(lane<groups ? partials[lane] : 0.0f);
+    float scale=peak==0.0f ? 1.0f : peak/127.0f;
+    if(tid==0) scales[row]=scale;
+    #pragma unroll
+    for(uint slot=0;slot<slots;++slot) {
+        uint block=slot*groups+sg;
+        #pragma unroll
+        for(uint reg=0;reg<registers;++reg)
+            output[base+block*256+reg*32+lane]=int8_t(clamp(
+                rint(values[slot][reg]/scale),-127.0f,127.0f));
+    }
