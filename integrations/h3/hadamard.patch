+/* GPU sampler state, in packed FP32 model coordinates after Euler. Reading
+ * happens only at existing completed windows, and never adds a GPU wait.
+ * A new file per step permits same-seed trajectory comparison before VAE. */
+static int capture_euler_latents(h3_dit *dit, int step,
+                                 size_t video_offset,size_t video_count,
+                                 size_t audio_offset,size_t audio_count,
+                                 char *error,size_t error_size) {
+    const char *directory=getenv("H3_LATENT_CAPTURE_DIR");
+    if(!directory) return 1;
+    const h3_gpu_tensor *tensor[2]={dit->video_input,dit->audio_input};
+    size_t offset[2]={video_offset,audio_offset}, count[2]={video_count,audio_count};
+    const char *kind[2]={"video","audio"};
+    for(unsigned stream=0;stream<2;++stream) {
+        float *values=malloc(count[stream]*sizeof(float));
+        if(!values || !h3_gpu_tensor_read_f32_range(tensor[stream],offset[stream],values,count[stream])) {
+            free(values); fail(error,error_size,"Euler latent readback failed"); return 0;
+        }
+        for(size_t i=0;i<count[stream];++i) if(!isfinite(values[i])) {
+            free(values); fail(error,error_size,"Euler latent nonfinite at step %d",step); return 0;
+        }
+        char path[4096];
+        int n=snprintf(path,sizeof(path),"%s/euler-step%02d-%s.f32",directory,step,kind[stream]);
+        if(n<0 || (size_t)n>=sizeof(path)) { free(values); fail(error,error_size,"Euler capture path too long"); return 0; }
+        int fd=open(path,O_WRONLY|O_CREAT|O_EXCL,0600);
+        FILE *f=fd<0?NULL:fdopen(fd,"wb");
+        if(!f) { if(fd>=0) close(fd); free(values); fail(error,error_size,"Euler capture exclusive open failed"); return 0; }
+        int ok=fwrite(values,sizeof(float),count[stream],f)==count[stream];
+        ok=fclose(f)==0 && ok; free(values);
+        if(!ok) { fail(error,error_size,"Euler latent write failed"); return 0; }
+    }
+    fprintf(stderr,"h3 latent capture: completed_step=%d video_f32=%zu audio_f32=%zu packed_order (diagnostic CPU readback)\n",step+1,video_count,audio_count);
+    return 1;
+}
