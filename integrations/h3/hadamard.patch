+static int capture_final_latents(h3_dit *dit,const float *video,const float *audio,
+                                  char *error,size_t error_size) {
+    const char *directory=getenv("H3_LATENT_CAPTURE_DIR");
+    if(!directory) return 1;
+    const float *data[2]={video,audio};
+    size_t count[2]={h3_dit_video_elements(dit),h3_dit_audio_elements(dit)};
+    const char *kind[2]={"video","audio"};
+    for(unsigned stream=0;stream<2;++stream) {
+        for(size_t i=0;i<count[stream];++i) if(!isfinite(data[stream][i])) {
+            fail(error,error_size,"final latent has nonfinite values"); return 0;
+        }
+        char path[4096];
+        int n=snprintf(path,sizeof(path),"%s/final-%s.f32",directory,kind[stream]);
+        if(n<0 || (size_t)n>=sizeof(path)) { fail(error,error_size,"final latent path too long"); return 0; }
+        int fd=open(path,O_WRONLY|O_CREAT|O_EXCL,0600);
+        FILE *f=fd<0?NULL:fdopen(fd,"wb");
+        if(!f) { if(fd>=0)close(fd); fail(error,error_size,"final latent exclusive open failed"); return 0; }
+        int ok=fwrite(data[stream],sizeof(float),count[stream],f)==count[stream];
+        ok=fclose(f)==0 && ok;
+        if(!ok) { fail(error,error_size,"final latent write failed"); return 0; }
+    }
+    char path[4096];
+    int n=snprintf(path,sizeof(path),"%s/latent-metadata.json",directory);
+    if(n<0 || (size_t)n>=sizeof(path)) { fail(error,error_size,"latent metadata path too long"); return 0; }
+    int fd=open(path,O_WRONLY|O_CREAT|O_EXCL,0600);
+    FILE *f=fd<0?NULL:fdopen(fd,"w");
+    if(!f) { if(fd>=0)close(fd); fail(error,error_size,"latent metadata exclusive open failed"); return 0; }
+    struct timespec wall,mono;
+    clock_gettime(CLOCK_REALTIME,&wall); clock_gettime(CLOCK_MONOTONIC,&mono);
+    const char *seed=getenv("H3_CAPTURE_SEED");
+    fprintf(f,"{\"schema\":1,\"scope\":\"diagnostic_CPU_readback_after_completed_GPU_Euler\",\"dtype\":\"float32_little_endian\",\"seed\":%s,\"seed_source\":\"caller_declared_H3_CAPTURE_SEED_verify_against_request_manifest\",\"completed_steps\":%d,\"time_unix_seconds\":%.9f,\"time_monotonic_seconds\":%.9f,\"final_video_shape\":[%d,%d,%d,%d],\"final_audio_shape\":[%d,%d,%d],\"final_layout\":\"unpacked_contiguous_VAE_input_before_decoder\",\"per_step_video_shape\":[%u,%d],\"per_step_audio_shape\":[%u,%d],\"per_step_layout\":\"packed_model_rows_after_Euler_before_unpack\",\"final_video_sigma\":%.9g,\"final_audio_sigma\":%.9g,\"int8_mlp\":%d,\"int8_qkv\":%d,\"int8_attention_out\":%d,\"hadamard_fc2\":%d,\"finite\":true}\n",seed?seed:"null",dit->sigmas.steps,(double)wall.tv_sec+(double)wall.tv_nsec*1e-9,(double)mono.tv_sec+(double)mono.tv_nsec*1e-9,VIDEO_CHANNELS,dit->latent_t,dit->latent_h,dit->latent_w,AUDIO_CHANNELS,AUDIO_STREAMS,dit->audio_t,dit->video_rows,VIDEO_PATCH,dit->audio_rows,AUDIO_CHANNELS,dit->sigmas.video[dit->sigmas.steps],dit->sigmas.audio[dit->sigmas.steps],dit->int8_mlp,dit->int8_qkv,dit->int8_attention_out,dit->use_hadamard_fc2);
+    int ok=!ferror(f); ok=fclose(f)==0 && ok;
+    if(!ok) fail(error,error_size,"final latent metadata write failed");
+    return ok;
+}
