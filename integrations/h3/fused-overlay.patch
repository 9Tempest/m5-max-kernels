+/* Optional projection epilogue. Preserve both existing BF16 boundaries. */
+inline bfloat h3_fused_gate_value(float projection,
+                                  device const ushort *residual,
+                                  device const ushort *modulation,
+                                  device const uint *row_map,
+                                  constant gate_args &gate,
+                                  uint row, uint column) {
+    float branch = (float)(bfloat)projection;
+    uint index = row * gate.width + column;
+    uint base = row_map[row] * gate.slots * gate.width;
+    float scale = h3_bf16_to_f32(modulation[base + gate.gate_slot * gate.width + column]);
+    float value = h3_bf16_to_f32(residual[index]) + branch * scale;
+    return (bfloat)h3_bf16_to_f32(h3_f32_to_bf16(value));
+}
