+/* Opt-in actual prep capture; inputs are snapshotted before any in-place gate.
+ * Normal execution makes exactly the selected prep call, with no new dispatch
+ * or readback. Captures deliberately submit/restart and are never perf runs. */
+static int h256_capture_write(const char *stem, const char *suffix,
+                              const void *data, size_t bytes) {
+    char path[4096];
+    int n=snprintf(path,sizeof(path),"%s-%s",stem,suffix);
+    if(n<0 || (size_t)n>=sizeof(path)) return 0;
+    int fd=open(path,O_WRONLY|O_CREAT|O_EXCL,0600);
+    if(fd<0) return 0;
+    FILE *f=fdopen(fd,"wb");
+    if(!f) { close(fd); return 0; }
+    int ok=fwrite(data,1,bytes,f)==bytes;
+    return fclose(f)==0 && ok;
+}
