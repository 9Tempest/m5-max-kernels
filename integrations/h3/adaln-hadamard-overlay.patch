+kernel void h3_adaln_h256_int8_k5376(
+        device const ushort *residual [[buffer(0)]],
+        device const ushort *branch [[buffer(1)]],
+        device const ushort *gamma [[buffer(2)]],
+        device const ushort *gate_modulation [[buffer(3)]],
+        device const ushort *norm_modulation [[buffer(4)]],
+        device const uint *gate_map [[buffer(5)]],
+        device const uint *norm_map [[buffer(6)]],
+        device ushort *gated_residual [[buffer(7)]],
+        device int8_t *codes [[buffer(8)]],
+        device float *scales [[buffer(9)]],
+        device ushort *adaln_capture [[buffer(10)]],
+        constant h3_adaln_h256_args &args [[buffer(11)]],
+        uint tid [[thread_index_in_threadgroup]],
+        ushort sg [[simdgroup_index_in_threadgroup]],
+        ushort lane [[thread_index_in_simdgroup]],
+        uint row [[threadgroup_position_in_grid]]) {
+    constexpr uint width=5376, groups=8, slots=3, registers=8;
+    uint base=row*width;
+    if(row>=args.rows) {
+        for(uint j=tid;j<width;j+=256) codes[base+j]=0;
+        if(tid==0) scales[row]=1.0f;
+        return;
+    }
