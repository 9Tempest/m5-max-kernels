+                    samples+j*HIDDEN,HIDDEN) &&
+               h3_gpu_tensor_read_u32_range(norm_map,ids[j],nm+j,1);
+            if(apply_gate) ok=ok &&
+                h3_gpu_tensor_read_bf16_range(branch,(size_t)ids[j]*HIDDEN,samples+span+j*HIDDEN,HIDDEN) &&
+                h3_gpu_tensor_read_u32_range(gate_map,ids[j],gm+j,1) &&
+                h3_gpu_tensor_read_bf16_range(gate_modulation,
+                    ((size_t)gm[j]*SLOTS+gate_slot)*HIDDEN,samples+2*span+j*HIDDEN,HIDDEN);
