+    peak=simd_max(peak);
+    if(lane==0) reductions[sg]=peak;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    peak=simd_max(lane<groups ? reductions[lane] : 0.0f);
+    float scale=peak==0.0f ? 1.0f : peak/127.0f;
