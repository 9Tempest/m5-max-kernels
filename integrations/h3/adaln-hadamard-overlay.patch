+        family,step,block,rows,count,HIDDEN,SLOTS,gate_slot,shift_slot,scale_slot,apply_gate,
+        dit->hadamard_prep_staged,dit->use_hadamard_qkv,dit->use_hadamard_fc1,dit->use_hadamard_fc2);
+    for(size_t j=0;j<count;++j) fprintf(f,"%s%u",j?",":"",ids[j]);
+    fprintf(f,"],\"segments\":[");
+    for(size_t j=0;j<dit->layout.segment_count;++j) {
+        const h3_segment *part=&dit->layout.segments[j];
+        fprintf(f,"%s{\"kind\":%d,\"start\":%zu,\"stop\":%zu}",j?",":"",part->kind,part->start,part->stop);
+    }
