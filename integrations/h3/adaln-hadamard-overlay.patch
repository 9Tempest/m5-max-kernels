+            fail(error,error_size,"H256 capture needs a nonempty directory and full packed rows"); return 0;
+        }
+        /* Include each actual modality boundary, then spread remaining rows. */
+        for(size_t segment=0;segment<dit->layout.segment_count;++segment) {
+            const h3_segment *part=&dit->layout.segments[segment];
+            if(part->stop<=part->start) continue;
+            size_t selected[]={part->start,part->start+(part->stop-part->start)/2,part->stop-1};
+            for(size_t j=0;j<3;++j) {
+                int seen=0;
+                for(size_t k=0;k<count;++k) seen|=ids[k]==selected[j];
+                if(!seen) {
+                    if(count==16) { fail(error,error_size,"H256 capture exceeds 16 boundary rows"); return 0; }
+                    ids[count++]=(uint32_t)selected[j];
+                }
+            }
+        }
+        for(uint32_t divisor=16;count<16 && divisor<=256;divisor*=2) {
+            for(uint32_t j=1;j<divisor && count<16;++j) {
