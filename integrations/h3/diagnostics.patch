+/* Optional diagnostic additions: M5MaxLocalBenchmark, MIT. No GPU waits. */
+static double diagnostic_now(void) {
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) return 0.0;
+    return (double)now.tv_sec + (double)now.tv_nsec * 1e-9;
+}
+
+static int diagnostic_step(const h3_dit *dit, int step) {
+    return dit->diagnostics &&
+        (step == 0 || step == dit->sigmas.steps / 2 ||
+         step == dit->sigmas.steps - 1);
+}
+
+static void diagnostic_operation(h3_dit *dit, int step, unsigned block,
+                                  uint32_t rows, const char *operation,
+                                  double started, h3_gpu_stats before) {
+    double elapsed = diagnostic_now() - started;
+    h3_gpu_stats after = {0};
+    h3_gpu_get_stats(dit->gpu, &after);
+    fprintf(stderr,
+        "h3 diag: {\"schema\":1,\"kind\":\"operation\",\"step\":%d,"
+        "\"block\":%u,\"rows\":%u,\"operation\":\"%s\",\"calls\":1,"
+        "\"host_api_ms\":%.6f,\"direct\":%llu,\"mps_linear\":%llu,"
+        "\"mps_sdpa\":%llu,\"submissions\":%llu}\n",
+        step, block, rows, operation, elapsed * 1000.0,
+        (unsigned long long)(after.direct_dispatches - before.direct_dispatches),
+        (unsigned long long)(after.mps_linear_dispatches - before.mps_linear_dispatches),
+        (unsigned long long)(after.mps_sdpa_dispatches - before.mps_sdpa_dispatches),
+        (unsigned long long)(after.submissions - before.submissions));
+}
+
+/* Call only after an existing successful submit: shared storage is now stable.
+ * These are post-Euler target latents, not per-layer calibration activations. */
+static void diagnostic_latent(const h3_gpu_tensor *tensor, size_t offset,
+                               float *scratch, size_t count, int step,
+                               const char *modality) {
+    if (!h3_gpu_tensor_read_f32_range(tensor, offset, scratch, count)) {
+        fprintf(stderr, "h3 diag: {\"schema\":1,\"kind\":\"latent\","
+                "\"step\":%d,\"modality\":\"%s\",\"status\":\"read_failed\"}\n",
+                step, modality);
+        return;
+    }
+    size_t finite = 0, zero = 0, histogram[12] = {0};
+    const double upper[11] = {0, 0.0625, 0.125, 0.25, 0.5, 1, 2, 4, 8, 16, 32};
+    double minimum = 0.0, maximum = 0.0, sum_square = 0.0;
+    for (size_t i = 0; i < count; i++) {
+        double value = scratch[i];
+        if (!isfinite(value)) continue;
+        if (!finite || value < minimum) minimum = value;
+        if (!finite || value > maximum) maximum = value;
+        finite++;
+        if (value == 0.0) zero++;
+        sum_square += value * value;
+        size_t bin = 0;
+        while (bin < 11 && fabs(value) > upper[bin]) bin++;
+        histogram[bin]++;
+    }
+    fprintf(stderr,
+        "h3 diag: {\"schema\":1,\"kind\":\"latent\",\"step\":%d,"
+        "\"modality\":\"%s\",\"status\":\"sampled\",\"boundary\":\"post_euler\","
+        "\"elements\":%zu,\"finite\":%zu,\"nonfinite\":%zu,\"zeros\":%zu,"
+        "\"finite_min\":%.9g,\"finite_max\":%.9g,\"finite_rms\":%.9g,"
+        "\"abs_upper_inclusive\":[0,0.0625,0.125,0.25,0.5,1,2,4,8,16,32,null],"
+        "\"abs_counts\":[%zu,%zu,%zu,%zu,%zu,%zu,%zu,%zu,%zu,%zu,%zu,%zu]}\n",
+        step, modality, count, finite, count - finite, zero, minimum, maximum,
+        finite ? sqrt(sum_square / (double)finite) : 0.0,
+        histogram[0], histogram[1], histogram[2], histogram[3],
+        histogram[4], histogram[5], histogram[6], histogram[7],
+        histogram[8], histogram[9], histogram[10], histogram[11]);
+}
